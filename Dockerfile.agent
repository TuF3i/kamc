# kamc Agent 镜像（目标集群内运行；无前端）
ARG GO_IMAGE=golang:1.26-alpine

FROM ${GO_IMAGE} AS build
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/TuF3i/kamc/internal/version.Version=${VERSION} -X github.com/TuF3i/kamc/internal/version.Commit=${COMMIT}" \
      -o /out/kamc-agent ./cmd/kamc-agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
 && adduser -D -H -u 10001 kamc
WORKDIR /app
COPY --from=build /out/kamc-agent /app/kamc-agent
USER kamc
ENTRYPOINT ["/app/kamc-agent"]
