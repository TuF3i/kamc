# 复制为 deploy/docker/.env 后按需修改。不要提交 .env。
POSTGRES_USER=kamc
POSTGRES_PASSWORD=kamc
POSTGRES_DB=kamc
KAMC_PORT=8080

AM_ENV=development
AM_EXTERNAL_URL=http://localhost:8080
AM_JWT_ISSUER=http://localhost:8080
AM_PASSWORD_LOGIN=1
AM_PASSWORD_LOGIN_USER=sysadmin
AM_PASSWORD_LOGIN_PASSWORD=sysadmin123
# 生产必须显式设置；本地留空时平台会派生开发用密钥并告警
AM_AVATAR_SECRET=

# 头像存储：默认 auto（未配置 MinIO 时使用本地卷）
AM_AVATAR_BACKEND=auto
AM_AVATAR_DIR=/data/avatar

# 启用 MinIO（配合 --profile minio）时取消注释：
# AM_AVATAR_BACKEND=minio
# AM_AVATAR_MINIO_ENDPOINT=minio:9000
# AM_AVATAR_MINIO_ACCESS_KEY=kamc
# AM_AVATAR_MINIO_SECRET_KEY=kamc-minio-secret
# AM_AVATAR_MINIO_BUCKET=kamc-avatars
# AM_AVATAR_MINIO_USE_SSL=false
# MINIO_ROOT_USER=kamc
# MINIO_ROOT_PASSWORD=kamc-minio-secret
