{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP 请求速率",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "sum(rate(kamc_http_requests_total[5m]))", "legendFormat": "all"},
        {"refId": "B", "expr": "sum(rate(kamc_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx"}
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 延迟 P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(kamc_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "stat",
      "title": "处理中请求",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "kamc_http_requests_in_flight"}]
    },
    {
      "type": "stat",
      "title": "在线隧道",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 4, "x": 20, "y": 0},
      "targets": [
        {"refId": "A", "expr": "kamc_tunnel_connected_clusters", "legendFormat": "clusters"},
        {"refId": "B", "expr": "kamc_tunnel_attached_agents", "legendFormat": "agents"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Casbin 判定（allow / deny / error）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "sum by (result) (rate(kamc_casbin_decisions_total[5m]))", "legendFormat": "{{result}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "登录尝试（成功 / 失败）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "sum by (method, result) (rate(kamc_auth_attempts_total[5m]))", "legendFormat": "{{method}} {{result}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "审计事件（写入 / spill / 丢弃）",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "sum by (result) (rate(kamc_audit_events_total[5m]))", "legendFormat": "{{result}}"}
      ]
    },
    {
      "type": "stat",
      "title": "审计队列深度",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "targets": [{"refId": "A", "expr": "kamc_audit_queue_depth"}]
    },
    {
      "type": "timeseries",
      "title": "审计写入延迟 P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(kamc_audit_write_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "头像操作",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "sum by (backend, operation, result) (rate(kamc_avatar_operations_total[5m]))", "legendFormat": "{{backend}} {{operation}} {{result}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Go 堆内存 / Goroutines",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}},
      "targets": [
        {"refId": "A", "expr": "go_memstats_heap_alloc_bytes", "legendFormat": "heap"},
        {"refId": "B", "expr": "go_goroutines", "legendFormat": "goroutines"}
      ]
    },
    {
      "type": "logs",
      "title": "集群审计日志（Loki）",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{job=\"kamc-cluster-audit\"}"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kamc"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "kamc 平台概览",
  "uid": "kamc-overview",
  "version": 1
}
